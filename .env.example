# Aussie Grid — household pilot frontend (aussie-grid-app)
# Copy to .env.local for Vite. On Vercel: Project Settings → Environment Variables → redeploy.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...or_sb_publishable_...

# Optional FastAPI base for CEO approve, Sigenergy dry-run, and Sungrow Renew.
# VITE_API_URL=https://aussie-grid-fastapi.onrender.com

# Invite code for Create account on Login. Required for volunteers.
# Set this on Vercel (Production + Preview) then redeploy so it is baked into the build.
VITE_PILOT_INVITE_CODE=VOLUNTEER

# Optional comma-separated admin emails for impersonation (fail closed if unset).
# VITE_ADMIN_EMAILS=help@aussiegrid.au
