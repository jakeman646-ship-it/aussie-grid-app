# Aussie Grid — household pilot frontend (aussie-grid-app)
# Copy to .env.local for Vite. On Vercel: Project Settings → Environment Variables → redeploy.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...or_sb_publishable_...

# Optional FastAPI base for CEO approve, Sigenergy dry-run, and Sungrow Renew.
# VITE_API_URL=https://aussie-grid-fastapi.onrender.com

# Pilot invite is a server secret. Do not add VITE_PILOT_INVITE_CODE.
# A VITE_ variable is compiled into the public JavaScript bundle, and a
# compare in the browser can be skipped by calling signUp directly.
#
# Set these as Supabase Edge Function secrets (not Vercel client env):
#   PILOT_INVITE_CODE                 long random code; rotate any code that
#                                     was previously shipped in the client
#   BEFORE_USER_CREATED_HOOK_SECRET   v1,whsec_... from Authentication → Hooks
#
# Deploy with JWT verification off (signup has no session; Auth signs the hook):
#   supabase functions deploy pilot-signup --no-verify-jwt
#   supabase functions deploy before-user-created --no-verify-jwt
# Dashboard → Authentication → Hooks → Before user created → HTTPS
#   https://<project-ref>.supabase.co/functions/v1/before-user-created
#
# Create account calls pilot-signup. There is no client-side fallback.
# Signup is not enforced against a direct GoTrue signUp until the hook is on.

# Optional comma-separated admin emails for impersonation (fail closed if unset).
# VITE_ADMIN_EMAILS=help@aussiegrid.au
